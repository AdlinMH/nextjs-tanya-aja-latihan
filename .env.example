# Salin file ini menjadi .env.local lalu isi nilainya.
# Jangan pernah memakai awalan NEXT_PUBLIC_ untuk variabel di bawah ini.

# Pembeda kelompok: huruf kecil, angka, tanda hubung. Contoh: kelompok-01
GROUP_ID=kelompok-01

# PIN pemilik: tepat 4 angka. Ganti dengan PIN milik kelompok.
OWNER_PIN=0000

# Supabase > Project Settings > Data API (Project URL)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Secret key (sb_secret_...)
# Hanya untuk server. Jangan dibagikan atau di-commit.
SUPABASE_SECRET_KEY=isi-secret-key-di-sini
